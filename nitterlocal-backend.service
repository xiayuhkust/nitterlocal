[Unit]
Description=Nitterlocal Backend Service
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/nitterlocal
ExecStart=/bin/bash -c 'source /home/ubuntu/nitterlocal/.env && /usr/bin/python3 -m app.main --host 0.0.0.0 --port 8000'
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nitterlocal-backend
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
